# Utayomi API Configuration
# Copy this file to .env and set your actual API keys

# Google Gemini API Key (無料利用可能)
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Google Gemini API Key (課金設定あり - TTS/Pro機能用)
# Get from: https://aistudio.google.com/app/apikey
# 課金設定が必要な機能（TTS、一部のProモデル）を利用する場合に設定
GOOGLE_API_KEY_PAID=your-paid-google-api-key-here

# OpenAI API Key  
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Cohere API Key
# Get from: https://dashboard.cohere.ai/api-keys  
COHERE_API_KEY=your-cohere-api-key-here